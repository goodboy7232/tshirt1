# Set these in the API server's environment before starting it.
API_PORT=3001
AUTH_DATA_DIR=./data
# Generate a long random value. Needed only once to bootstrap the first admin.
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-secret
# Production only: set to true temporarily for the first-admin bootstrap, then remove it.
ADMIN_BOOTSTRAP_ENABLED=true
